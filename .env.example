# Required for the Strategy Copilot RAG chatbot
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Optional: MongoDB Atlas connection string for prediction/research logging
# Without this, the API works normally — logging silently no-ops
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: protect the /research endpoint with an API key.
# When set, requests must send a matching "X-API-Key" header.
# Set the same value as API_KEY in Streamlit secrets so the frontend can call it.
# Leave unset to keep the API fully open (local dev / public demo).
# API_KEY=change-me

# Optional: per-minute rate limits (per client IP). Defaults shown.
# RATE_LIMIT_PREDICT_PER_MIN=60
# RATE_LIMIT_BATCH_PER_MIN=10
# RATE_LIMIT_RESEARCH_PER_MIN=10
# RATE_LIMIT_ANALYTICS_PER_MIN=30
